{
  "device": {
    "id": "esp32_front_door",
    "name": "Front Door Edge Slave",
    "heartbeat_interval_s": 30
  },
  "wifi": {
    "ssid": "YOUR_WIFI_SSID",
    "password": "YOUR_WIFI_PASSWORD",
    "connect_timeout_s": 20,
    "max_retries": 5
  },
  "mqtt": {
    "host": "192.168.1.100",
    "port": 1883,
    "user": "",
    "password": "",
    "keepalive": 60,
    "base_topic": "slave/front_door",
    "ha_discovery_prefix": "homeassistant"
  },
  "ota": {
    "enabled": true,
    "manifest_url": "http://192.168.1.50:8080/firmware/manifest.json",
    "check_on_boot": true,
    "check_interval_s": 86400
  },
  "components": {
    "door_bolt": {
      "type": "solenoid",
      "pin": 23,
      "active_high": true,
      "default_pulse_ms": 3000,
      "max_pulse_ms": 8000
    },
    "buzzer": {
      "type": "digital_out",
      "pin": 19,
      "active_high": true
    },
    "led_status": {
      "type": "digital_out",
      "pin": 2,
      "active_high": true
    },
    "door_contact": {
      "type": "digital_in",
      "pin": 4,
      "pull": "up",
      "invert": true,
      "report_changes": true,
      "ha_device_class": "door"
    },
    "fingerprint": {
      "type": "as608",
      "uart_id": 2,
      "tx_pin": 17,
      "rx_pin": 16,
      "baudrate": 57600,
      "password": 0,
      "address": 4294967295
    }
  },
  "routines": {
    "door_unlock": [
      {
        "action": "pulse",
        "target": "buzzer",
        "duration_ms": 120
      },
      {
        "action": "pulse",
        "target": "door_bolt",
        "duration_ms": 3000
      }
    ],
    "door_lock": [
      {
        "action": "digital_write",
        "target": "door_bolt",
        "state": 0
      }
    ],
    "chime_success": [
      {
        "action": "pulse",
        "target": "buzzer",
        "duration_ms": 100
      },
      {
        "action": "delay",
        "duration_ms": 80
      },
      {
        "action": "pulse",
        "target": "buzzer",
        "duration_ms": 150
      }
    ]
  }
}
