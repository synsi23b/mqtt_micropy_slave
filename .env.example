# Remote Test Broker & Device Configuration
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
DEVICE_ID=esp32_hil_dut

# Raspberry Pi Remote HIL Rig Configuration
HIL_PI_HOST=192.168.1.50
HIL_PI_USER=pi
HIL_PI_KEY=~/.ssh/id_ed25519
HIL_PI_PORT=22

# Raspberry Pi Physical Pin Mapping (BCM Numbers)
PI_SOLENOID_PIN=17
PI_PWM_PIN=23
PI_DIGITAL_OUT_PIN=27
PI_INPUT_STIMULUS_PIN=22
PI_UART_PORT=/dev/serial0
